# ==============================================================================
# DeskSolutions Production & Development Environment Configuration
# Target: https://control.desksolutions.in
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=production

# ------------------------------------------------------------------------------
# Control Center Server Configuration (control.desksolutions.in)
# ------------------------------------------------------------------------------
CONTROL_CENTER_HOST=0.0.0.0
CONTROL_CENTER_PORT=5000
PORT=5000

# Canonical Public & WebSocket URLs
CONTROL_CENTER_PUBLIC_URL=https://control.desksolutions.in
CONTROL_CENTER_WS_URL=wss://control.desksolutions.in/v1/telemetry

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://control.desksolutions.in,https://desksolutions.in,http://localhost:5000,http://127.0.0.1:5000

# Security Secret for Admin / Founder Operations
AUTH_SECRET=generate-a-strong-random-secret-in-production
CONTROL_CENTER_SECRET=generate-a-strong-random-secret-in-production

# Command Cryptographic Signing Secret (Master fallback key for HMAC-SHA256 remote commands)
COMMAND_SIGNING_SECRET=generate-a-strong-command-signing-secret-in-production

# Single-Use Enrollment Key TTL in milliseconds (Default: 86400000 = 24 hours)
ENROLLMENT_KEY_TTL=86400000

# Control Center Persistent SQLite Storage (WAL Mode)
DB_PATH=cloud_control.db

# ------------------------------------------------------------------------------
# Desktop ERP Client Configuration (Electron App)
# ------------------------------------------------------------------------------
# Production Cloud Endpoints (Shop Client will connect to these)
CLOUD_SERVER_URL=https://control.desksolutions.in
CLOUD_MASTER_URL=wss://control.desksolutions.in/v1/telemetry

# Optional Sentry DSN for Centralized Crash Reporting
SENTRY_DSN=
