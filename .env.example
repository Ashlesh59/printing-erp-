# ==============================================================================
# DeskSolutions Production & Development Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=production

# ------------------------------------------------------------------------------
# Control Center Server Configuration (control.desksolutions.in)
# ------------------------------------------------------------------------------
PORT=5000

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://control.desksolutions.in,https://desksolutions.in,http://localhost:5000,http://127.0.0.1:5000

# Security Secret for Admin / Founder Operations
CONTROL_CENTER_SECRET=change-this-to-a-strong-random-secret-in-production

# Persistent Database (PostgreSQL URL for scalable production or empty for SQLite WAL)
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# SQLite Local Storage Path (Used when DATABASE_URL is not set)
DB_PATH=cloud_control.db

# ------------------------------------------------------------------------------
# Desktop ERP Client Configuration (Electron App)
# ------------------------------------------------------------------------------
# Production Cloud URLs
CLOUD_SERVER_URL=https://control.desksolutions.in
CLOUD_MASTER_URL=wss://control.desksolutions.in/v1/telemetry

# Optional Sentry DSN for Centralized Crash Reporting
SENTRY_DSN=
