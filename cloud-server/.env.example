# ==============================================================================
# DeskSolutions Control Center — Environment Configuration Template
# Target: https://control.desksolutions.in
# ==============================================================================

# Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=production

# Server Binding
CONTROL_CENTER_HOST=0.0.0.0
CONTROL_CENTER_PORT=5000

# Canonical Public & WebSocket URLs
CONTROL_CENTER_PUBLIC_URL=https://control.desksolutions.in
CONTROL_CENTER_WS_URL=wss://control.desksolutions.in/v1/telemetry

# Persistent Database File (Better-SQLite3 in WAL mode)
# In production container (Docker/VPS/Railway), point to mounted persistent volume
DB_PATH=/app/data/cloud_control.db

# Persistent Backups and Uploads Directories
BACKUPS_DIR=/app/data/backups
BACKUP_RETENTION_DAYS=30
UPLOADS_DIR=/app/data/uploads

# Allowed CORS Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://control.desksolutions.in,https://desksolutions.in

# Founder Administrative API Key (Required in production for all admin operations)
ADMIN_API_KEY=generate-a-strong-random-secret-in-production
AUTH_SECRET=generate-a-strong-random-secret-in-production

# Command Cryptographic Signing Secret (Master fallback key for HMAC-SHA256 remote commands)
COMMAND_SIGNING_SECRET=generate-a-strong-command-signing-secret-in-production

# Single-Use Enrollment Key TTL in milliseconds (Default: 86400000 = 24 hours)
ENROLLMENT_KEY_TTL=86400000
